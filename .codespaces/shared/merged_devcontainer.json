{
  "image": "mcr.microsoft.com/devcontainers/base:alpine",
  "remoteUser": "vscode",
  "containerEnv": {
    "CODESPACES_RECOVERY_CONTAINER": "true",
    "CODESPACES": "true",
    "ContainerVersion": "13",
    "RepositoryName": "recycling-commerce-backend"
  },
  "runArgs": [
    "--label",
    "ContainerVersion=13",
    "--hostname",
    "codespaces-b00a2a",
    "--add-host",
    "codespaces-b00a2a:127.0.0.1",
    "--cap-add",
    "sys_nice",
    "--network",
    "host"
  ],
  "remoteEnv": {
    "CLOUDENV_ENVIRONMENT_ID": "0021b452-3ce5-4ee1-b3e1-875565c8447b",
    "CODESPACE_NAME": "turbo-space-happiness-6vvrr7gxx9jjfxr75"
  },
  "mounts": [
    "source=/root/.codespaces/shared,target=/workspaces/.codespaces/shared,type=bind",
    "source=/var/lib/docker/codespacemount/.persistedshare,target=/workspaces/.codespaces/.persistedshare,type=bind",
    "source=/.codespaces/agent/mount,target=/.codespaces/bin,type=bind",
    "source=/mnt/containerTmp,target=/tmp,type=bind"
  ],
  "workspaceMount": "type=bind,src=/var/lib/docker/codespacemount/workspace,dst=/workspaces",
  "workspaceFolder": "/workspaces/recycling-commerce-backend"
}