# Application
APP_NAME=Recycle Commerce API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recycling_commerce

# Authentication
AUTH_SECRET=change-this-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Payments
PAYMENT_PROVIDER=mock
PAYMENT_KEY=
PAYMENT_SECRET=

# Email
EMAIL_PROVIDER=console
EMAIL_API_KEY=

# Logging
LOG_LEVEL=INFO
