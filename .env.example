# Application
APP_NAME=Recycle Commerce API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recycling_commerce

# Authentication
# Generate a random value of at least 32 characters for production.
AUTH_SECRET=change-this-development-secret-minimum-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURE_COOKIES=false

# Security
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Payments
PAYMENT_PROVIDER=mock
PAYMENT_KEY=
PAYMENT_SECRET=

# Email
# Set EMAIL_PROVIDER=resend and provide your Resend API key.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=GreenCore <onboarding@resend.dev>
CONTACT_EMAIL=dy3819@vidyagyan.in

# Logging
LOG_LEVEL=INFO

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
