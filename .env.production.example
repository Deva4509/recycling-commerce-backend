# ============================================================
# RECYCLE COMMERCE API - PRODUCTION
# ============================================================

APP_NAME=Recycle Commerce API
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Generate a cryptographically random value of at least 32 characters.
AUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Production PostgreSQL connection.
DATABASE_URL=REPLACE_WITH_PRODUCTION_DATABASE_URL

# Explicit frontend origins only.
CORS_ORIGINS=https://your-frontend-domain.com

# Storage
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Payments
PAYMENT_PROVIDER=REPLACE_WITH_PAYMENT_PROVIDER
PAYMENT_KEY=
PAYMENT_SECRET=

# Email
EMAIL_PROVIDER=REPLACE_WITH_EMAIL_PROVIDER
EMAIL_API_KEY=

# Logging
LOG_LEVEL=INFO
